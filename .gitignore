# Flutter / Dart
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
build/
pubspec.lock
packages/*/pubspec.lock
*.g.dart.bak

# Generated localisations: produced by flutter gen-l10n from the ARB files.
lib/l10n/app_localizations*.dart

# NOT ignored, on purpose:
#   lib/l10n/app_*.arb                 - generated, but reviewed and committed
#   lib/data/platform/*.g.dart         - Pigeon output, committed so the native
#   ios/Runner/Camera/*.g.swift          side can be read and built without
#   android/.../*.g.kt                   running codegen first

# Coverage output from `dart test --coverage`.
coverage/
packages/*/coverage/

# iOS
# Regenerated by `flutter pub get`; the Xcode project that consumes them is not
# in this repository yet.
ios/Flutter/ephemeral/
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Runner.xcworkspace/xcuserdata/
*.xcuserstate
*.mobileprovision
*.p12
*.p8
*.cer

# Android
android/.gradle/
android/local.properties
android/key.properties
android/app/*.jks
android/app/*.keystore
*.aab
*.apk

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/
fastlane/*.json

# Secrets, in every shape they arrive in
*.keystore
service-account*.json
AuthKey_*.p8
.env
.env.*

# Tooling
.idea/
.vscode/
*.iml
.DS_Store
__pycache__/
